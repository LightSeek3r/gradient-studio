{
  "name": "opal42",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line smoothness score and refiner for CSS gradients (OKLAB/OKLCH). Working name. No network, no telemetry.",
  "keywords": [
    "gradient",
    "css-gradient",
    "oklab",
    "oklch",
    "cli",
    "linter"
  ],
  "license": "MIT",
  "author": "LightSeek3r (https://github.com/LightSeek3r)",
  "homepage": "https://github.com/LightSeek3r/gradient-studio/blob/master/docs/cli.md",
  "bugs": {
    "url": "https://github.com/LightSeek3r/gradient-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightSeek3r/gradient-studio.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "opal42": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opal42/gradient": "^0.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "size": "size-limit",
    "prepack": "npm run build"
  }
}
