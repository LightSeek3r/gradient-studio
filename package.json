{
  "name": "gradient-studio",
  "private": true,
  "version": "0.1.0",
  "description": "A CSS gradient editor that scores gradients with perceptual colour science (OKLAB/OKLCH) and suggests a one-click refinement.",
  "license": "MIT",
  "author": "LightSeek3r (https://github.com/LightSeek3r)",
  "homepage": "https://gradient-studio-al4.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightSeek3r/gradient-studio.git"
  },
  "bugs": {
    "url": "https://github.com/LightSeek3r/gradient-studio/issues"
  },
  "keywords": [
    "gradient",
    "css-gradient",
    "oklab",
    "oklch",
    "color",
    "design-tools",
    "react",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w gradient-studio-web",
    "build": "npm run typecheck && npm run build -w gradient-studio-web",
    "lint": "eslint .",
    "preview": "npm run preview -w gradient-studio-web",
    "typecheck": "npm run typecheck -w @opal42/gradient",
    "test": "npm test --workspaces --if-present",
    "vectors": "npm run vectors -w @opal42/gradient",
    "vectors:diff": "npm run vectors:diff -w @opal42/gradient"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
